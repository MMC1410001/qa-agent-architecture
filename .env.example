# ============================================================================
# QA-OS Configuration File
# Copy to .env and update with your values
# ============================================================================

# API Configuration
# (default: 0.0.0.0)
API_HOST=UPDATE HERE
# (default: 8000)
API_PORT=UPDATE HERE
# (default: INFO)
API_LOG_LEVEL=UPDATE HERE
# (default: false)
DEBUG=UPDATE HERE

# LLM Provider Configuration
# Options: claude, openai, local
# (default: claude)
LLM_PROVIDER=UPDATE HERE
# (default: claude-sonnet-5)
LLM_MODEL=UPDATE HERE
LLM_API_KEY=UPDATE HERE
# (default: 0.7)
LLM_TEMPERATURE=UPDATE HERE
# (default: 4096)
LLM_MAX_TOKENS=UPDATE HERE
# (default: 60)
LLM_TIMEOUT=UPDATE HERE

# OpenAI Specific (if using openai provider)
OPENAI_API_KEY=UPDATE HERE
# (default: gpt-4o)
OPENAI_MODEL=UPDATE HERE

# Claude Specific (if using claude provider)
ANTHROPIC_API_KEY=UPDATE HERE

# Database Configuration
# (format: postgresql://USER:PASSWORD@HOST:5432/DBNAME)
DATABASE_URL=UPDATE HERE
# (default: false)
DATABASE_ECHO=UPDATE HERE
# (default: 20)
DATABASE_POOL_SIZE=UPDATE HERE
# (default: 3600)
DATABASE_POOL_RECYCLE=UPDATE HERE

# Redis Configuration
# (default: redis://localhost:6379/0)
REDIS_URL=UPDATE HERE
# (default: 10)
REDIS_POOL_SIZE=UPDATE HERE

# Agent Configuration
# (default: 300)
AGENT_TIMEOUT=UPDATE HERE
# (default: 3)
AGENT_RETRY_ATTEMPTS=UPDATE HERE
# (default: 5)
AGENT_RETRY_DELAY=UPDATE HERE
# (default: true)
AGENT_PARALLEL_EXECUTION=UPDATE HERE
# (default: 5)
MAX_CONCURRENT_AGENTS=UPDATE HERE

# Test Execution Configuration
# (default: 600)
TEST_EXECUTION_TIMEOUT=UPDATE HERE
# (default: chromium)
TEST_BROWSER_TYPE=UPDATE HERE
# (default: true)
TEST_HEADLESS=UPDATE HERE
# (default: 0)
TEST_SLOW_MO=UPDATE HERE
# (default: true)
TEST_SCREENSHOT_ON_FAILURE=UPDATE HERE

# Integration Configuration
# JIRA
JIRA_URL=UPDATE HERE
JIRA_USERNAME=UPDATE HERE
JIRA_API_TOKEN=UPDATE HERE

# GitHub
GITHUB_TOKEN=UPDATE HERE
GITHUB_OWNER=UPDATE HERE
GITHUB_REPO=UPDATE HERE

# Slack Notifications
SLACK_WEBHOOK_URL=UPDATE HERE
# (default: false)
SLACK_ENABLED=UPDATE HERE

# CI/CD Integration
JENKINS_URL=UPDATE HERE
JENKINS_USERNAME=UPDATE HERE
JENKINS_API_TOKEN=UPDATE HERE
# (or github-actions, gitlab-ci; default: jenkins)
CI_PROVIDER=UPDATE HERE

# Logging Configuration
# (or text; default: json)
LOG_FORMAT=UPDATE HERE
# (default: INFO)
LOG_LEVEL=UPDATE HERE
# (default: logs/qa-os.log)
LOG_FILE=UPDATE HERE

# Security
SECRET_KEY=UPDATE HERE
# (default: HS256)
JWT_ALGORITHM=UPDATE HERE
# (default: 24)
JWT_EXPIRATION_HOURS=UPDATE HERE
# (default: X-API-Key)
API_KEY_HEADER=UPDATE HERE

# Feature Flags
# (default: true)
FEATURE_ENABLE_REGRESSION_ANALYSIS=UPDATE HERE
# (default: true)
FEATURE_ENABLE_QUALITY_INSIGHTS=UPDATE HERE
# (default: true)
FEATURE_ENABLE_BUG_INVESTIGATION=UPDATE HERE
# (default: false)
FEATURE_ENABLE_JIRA_INTEGRATION=UPDATE HERE
# (default: false)
FEATURE_ENABLE_GITHUB_INTEGRATION=UPDATE HERE
# (default: false)
FEATURE_ENABLE_SLACK_NOTIFICATIONS=UPDATE HERE

# Performance Tuning
# (default: 30)
REQUEST_TIMEOUT=UPDATE HERE
# (default: 10)
CONNECTION_TIMEOUT=UPDATE HERE
# (default: 100)
BATCH_SIZE=UPDATE HERE
# (default: 3600)
CACHE_TTL=UPDATE HERE

# Quality Gates
# (default: 80)
MIN_TEST_COVERAGE=UPDATE HERE
# (default: 95)
MIN_TEST_PASS_RATE=UPDATE HERE
# (default: 5)
MAX_DEFECT_DENSITY=UPDATE HERE

# Monitoring & Analytics
# (default: true)
ENABLE_METRICS=UPDATE HERE
# (default: 9090)
METRICS_PORT=UPDATE HERE
# (default: false)
ENABLE_TRACING=UPDATE HERE
# (default: localhost)
JAEGER_AGENT_HOST=UPDATE HERE
# (default: 6831)
JAEGER_AGENT_PORT=UPDATE HERE

# Environment
# (development, staging, production; default: development)
ENVIRONMENT=UPDATE HERE
# (default: 1.0.0)
VERSION=UPDATE HERE

